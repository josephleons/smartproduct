APP_NAME=SmartLabel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8095
# Base URL encoded into QR stickers. Changing it breaks printed stickers.
APP_PUBLIC_URL=http://localhost:8095
APP_TIMEZONE=Africa/Dar_es_Salaam

#APP_ENV=production
#APP_DEBUG=false
#APP_URL=https://smartproduct.com
#
#DB_HOST=mysql
#DB_PASSWORD=WEKA_PASSWORD_IMARA
#DB_ROOT_PASSWORD=WEKA_PASSWORD_IMARA_NYINGINE
#REDIS_HOST=redis
#QUEUE_CONNECTION=redis

APP_LOCALE=sw
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker host ports (see docker-compose.yml)
APP_PORT=8095
FORWARD_DB_PORT=3315
FORWARD_REDIS_PORT=6385
FORWARD_PMA_PORT=8096
WWWUSER=1000
WWWGROUP=1000

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=smartlabel
DB_USERNAME=smartlabel
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=smartlabel

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@smartlabel.co"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
